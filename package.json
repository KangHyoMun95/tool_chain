{
  "name": "toolhackchain",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm --filter @toolhackchain/shared build && pnpm --filter api build && pnpm --filter @toolhackchain/web-admin build && pnpm --filter @toolhackchain/web-portal build",
    "dev:api": "pnpm --filter api start:dev",
    "dev:web": "pnpm --filter @toolhackchain/web-admin dev",
    "test": "pnpm --filter api test",
    "dev:portal": "pnpm --filter @toolhackchain/web-portal dev",
    "db:migrate": "docker compose run --rm flyway migrate",
    "db:info": "docker compose run --rm flyway info",
    "db:validate": "docker compose run --rm flyway validate"
  }
}
