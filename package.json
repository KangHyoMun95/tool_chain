{
  "name": "toolhackchain",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm --filter @toolhackchain/shared build && pnpm --filter @toolhackchain/api build && pnpm --filter @toolhackchain/web build",
    "dev:api": "pnpm --filter @toolhackchain/api dev",
    "dev:web": "pnpm --filter @toolhackchain/web dev",
    "test": "pnpm --filter @toolhackchain/api test"
  }
}
