# ==== AI provider selection ====
# One of: anthropic | gemini | deepseek | chatgpt
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
# Optional extra instructions appended to every agent decision prompt (tone, constraints, etc).
# The action/JSON contract itself is fixed in agent/prompt.py, not here.
AI_PROMPT=

# ==== API keys (only the selected provider's key is required) ====
ANTHROPIC_API_KEY=
GEMINI_API_KEY=AIzaSyCLJdwLqilU7mhQKT9tyT-aO1nkGXHwgzA
DEEPSEEK_API_KEY=
CHATGPT_API_KEY=

# ==== Base URL overrides (leave blank to use the provider default) ====
# DeepSeek requires a base url (OpenAI-compatible endpoint).
ANTHROPIC_BASE_URL=
GEMINI_BASE_URL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHATGPT_BASE_URL=

# ==== Site login credentials ====
# Referenced from sites.yaml via login_username_env / login_password_env.
# The agent decides when/where to type these, so their plain-text values are
# sent to the selected AI provider as part of the decision prompt at that step.
EXAMPLE_USERNAME=lingling7799
EXAMPLE_PASSWORD=htbt0606
