# Hiện khung debug các trường time (deliver_time, timestamp, stamp_time, round_start_time, repaint_time) ở trang chi tiết stream
NEXT_PUBLIC_SHOW_STREAM_DEBUG=true
# Nguồn dự đoán: live (AI thật qua SSE + /predictions/current, mặc định) hoặc mock (giả lập khi không chạy AI). Đọc lúc build.
NEXT_PUBLIC_PREDICTION_SOURCE=live

# Link liên hệ Telegram ở trang đăng nhập / đăng ký (vd https://t.me/xxx). Đọc ở server lúc chạy (KHÔNG build lại, chỉ cần restart).
# Để trống thì ẩn link Telegram. Chỉ chấp nhận http/https.
TELE_CONTRACT=
