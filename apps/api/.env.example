# PostgreSQL connection for apps/api (TypeORM)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=toolhackchain
# Optional: set to "true" to log SQL
DB_LOGGING=false

# Auth / JWT
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=1d

# Seed account (Admin Host) — used by `pnpm --filter @toolhackchain/api seed`
HOST_USERNAME=host
HOST_PASSWORD=Host@12345
