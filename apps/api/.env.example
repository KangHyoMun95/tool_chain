# Read by the API via dotenv (copy to apps/api/.env).
DATABASE_URL=postgresql://postgres:123456@localhost:5432/tool_chain
REDIS_URL=redis://:123456@localhost:6379
API_PORT=4000
# Múi giờ hệ thống (mốc 0h của job dọn dữ liệu, dashboard). Thiếu ⇒ API log WARN và chạy theo UTC. docker-compose đã đặt TZ cho mọi service.
TZ=Asia/Bangkok
CONSUMER_NAME=api-worker-0

# Origins allowed by CORS (comma separated): web-admin, web-portal
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5000,http://localhost:5001

# Auth — required, >= 32 chars each, must differ. Generate: openssl rand -base64 48
JWT_SECRET=change-me-generate-a-long-random-string
JWT_REFRESH_SECRET=change-me-generate-another-long-random-string

# Auth — optional (defaults shown)
# ACCESS_TOKEN_TTL_SECONDS=900
# SESSION_TTL_SECONDS=604800
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCK_MINUTES=15
# Set when behind a reverse proxy so req.ip is the real client IP: number of hops (e.g. 1) or "loopback"
# TRUST_PROXY: để trống = không tin proxy (req.ip = địa chỉ socket). Sau 1 nginx: 1. Sau Cloudflare + nginx: 2 (nginx phải chuyển IP thật vào X-Forwarded-For). Hoặc "loopback" / CIDR.
# Giới hạn đăng ký theo IP dùng req.ip. LƯU Ý khi chạy local bằng docker compose: mọi request tới từ cùng một IP nội bộ
# (vd 172.17.0.1) nên giới hạn đăng ký tính CHUNG cho cả máy; khi test local hãy đặt ngưỡng cao hơn (xem REGISTER_MAX_* bên dưới).
# TRUST_PROXY=
# Captcha ALTCHA chạy ngầm khi đăng ký. BẮT BUỘC (>= 32 ký tự): thiếu thì API không khởi động. Sinh: openssl rand -base64 48
ALTCHA_HMAC_KEY=change-me-generate-a-long-random-string-for-altcha
# Độ khó = số lần băm SHA-256 tối đa N (nghiệm ngẫu nhiên 0..N, trung bình N/2 lần băm, mỗi lần ~0,045 ms trên i5-8500 / Node ⇒ N=50000 trung bình ~1,1 giây,
# N=200000 trung bình ~4,5 giây). Mặc định 50000; điện thoại chậm hơn máy bàn nên đo lại trên máy thật: tăng N để khó hơn, giảm nếu giải quá lâu.
# Đổi chỉ cần restart API, không cần build lại portal.
# ALTCHA_MAX_NUMBER=50000
# ALTCHA_CHALLENGE_TTL_SECONDS=300
# Số lần đăng ký THÀNH CÔNG tối đa / IP trong cửa sổ trượt (mặc định 5 lần / 24 giờ) và số request đăng ký tối đa / IP / giờ (mặc định 20)
# Hiện CHỈ LOG khi vượt ngưỡng (ENFORCE_REGISTER_IP_LIMIT=false trong registration.limits.ts), chưa chặn.
# REGISTER_MAX_SUCCESS_PER_IP=5
# REGISTER_SUCCESS_WINDOW_HOURS=24
# REGISTER_MAX_REQUESTS_PER_HOUR=20

# Billing — phí mỗi dự đoán (điểm, số nguyên > 0). Bắt buộc: thiếu / sai thì API dừng.
PREDICTION_FEE=10
# Ván RUNNING không có result quá số phút này thì bị CANCELLED và hoàn tiền (mặc định 5).
# Job chỉ chạy khi GAME_SESSION_CANCEL_ENABLED=true (mặc định false).
# GAME_SESSION_CANCEL_AFTER_MINUTES=5
# GAME_SESSION_CANCEL_ENABLED=false
# false ⇒ KHÔNG hoàn tiền (dự đoán sai, kết quả T, ván CANCELLED). Mặc định true.
# Ván settlement lúc cờ tắt được đánh dấu bỏ hoàn: bật lại true KHÔNG hoàn bù các ván đó.
# HAS_REFUND=true
# Hub SSE: stream chỉ nhận tick cũ hơn phiên đang giữ liên tục quá số ms này ⇒ xóa state, tick kế tiếp khởi tạo lại (mặc định 60000).
# HUB_STALE_RESET_MS=60000
# Thư mục file định nghĩa category (config/categories/*.json). Bỏ trống: config/categories ở thư mục chạy hoặc ở gốc repo
# (API KHÔNG khởi động nếu thư mục rỗng hoặc file sai schema).
# CATEGORY_CONFIG_DIR=/app/config/categories
# true ⇒ log thêm mức DEBUG (mặc định false: chỉ log / warn / error / fatal).
# API_LOG_DEBUG=false
