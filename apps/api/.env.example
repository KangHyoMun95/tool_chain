# Read by the API via dotenv (copy to apps/api/.env).
DATABASE_URL=postgresql://postgres:123456@localhost:5432/tool_chain
REDIS_URL=redis://:123456@localhost:6379
API_PORT=4000
CONSUMER_NAME=api-worker-0

# Origins allowed by CORS (comma separated): web-admin, web-portal
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Auth — required, >= 32 chars each, must differ. Generate: openssl rand -base64 48
JWT_SECRET=change-me-generate-a-long-random-string
JWT_REFRESH_SECRET=change-me-generate-another-long-random-string

# Auth — optional (defaults shown)
# ACCESS_TOKEN_TTL_SECONDS=900
# SESSION_TTL_SECONDS=604800
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCK_MINUTES=15
# Set when behind a reverse proxy so req.ip is the real client IP: number of hops (e.g. 1) or "loopback"
# TRUST_PROXY=

# Billing — phí mỗi dự đoán (điểm, số nguyên > 0). Bắt buộc: thiếu / sai thì API dừng.
PREDICTION_FEE=10
# Ván RUNNING không có result quá số phút này thì bị CANCELLED và hoàn tiền (mặc định 5).
# Job chỉ chạy khi GAME_SESSION_CANCEL_ENABLED=true (mặc định false).
# GAME_SESSION_CANCEL_AFTER_MINUTES=5
# GAME_SESSION_CANCEL_ENABLED=false
# Hub SSE: stream chỉ nhận tick cũ hơn phiên đang giữ liên tục quá số ms này ⇒ xóa state, tick kế tiếp khởi tạo lại (mặc định 60000).
# HUB_STALE_RESET_MS=60000
# true ⇒ log thêm mức DEBUG (mặc định false: chỉ log / warn / error / fatal).
# API_LOG_DEBUG=false
