# Tài khoản + site (bắt buộc)
APP_USER=
APP_PASSWORD=
WEBSITE_URL=
# Brave (login browser, tầng 3)
BRAVE_PATH=
# Tên lobby / category gửi lên api (khớp tên trong DB)
SX_LOBBY=
SX_CATEGORY_1=
# Bật / tắt từng WSS (WS_TARGETS ở main.py): WS_ENABLED_<TÊN IN HOA>, mặc định true
WS_ENABLED_TGMEQ=true
# Lỗi cấp phiên (check bot, vượt giới hạn login browser): chờ bao nhiêu giây rồi thoát mã 1 cho Docker chạy lại
RESTART_DELAY=600
