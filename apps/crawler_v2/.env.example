# Site + Brave (login browser, tầng 3)
WEBSITE_URL=
BRAVE_PATH=
# Lỗi cấp phiên (check bot, vượt giới hạn login browser): chờ bao nhiêu giây rồi thoát mã 1 cho Docker chạy lại
RESTART_DELAY=600
# Bật / tắt từng WSS (WS_TARGETS ở main.py — không còn dùng ở luồng chính)
WS_ENABLED_TGMEQ=true

# ---- Mỗi category một tài khoản (chỉ số <n> không cần liên tục) ----
# GAME_GROUP_ID_<n>           gameGroupId gửi cho queryInitWebGameHall
# GAME_GROUP_ID_<n>_USERNAME  / _PASSWORD  tài khoản RIÊNG của category (không được trùng giữa các category đang bật)
# GAME_GROUP_ID_<n>_LOBBY     / _CATEGORY  tên lobby / category gửi lên api (khớp config/categories/*.json)
# GAME_GROUP_ID_<n>_HANDLER   sx_lobby | sx_group_2 | sx_group_3
# GAME_GROUP_ID_<n>_ENABLED   true|false, bỏ trống = true
# Category 1: baccarat (handler cũ), tạm tắt. Bật lại thì chạy y như trước.
GAME_GROUP_ID_1=-1
GAME_GROUP_ID_1_USERNAME=
GAME_GROUP_ID_1_PASSWORD=
GAME_GROUP_ID_1_LOBBY=
GAME_GROUP_ID_1_CATEGORY=
GAME_GROUP_ID_1_HANDLER=sx_lobby
GAME_GROUP_ID_1_ENABLED=false
# Category 2
GAME_GROUP_ID_2=
GAME_GROUP_ID_2_USERNAME=
GAME_GROUP_ID_2_PASSWORD=
GAME_GROUP_ID_2_LOBBY=
GAME_GROUP_ID_2_CATEGORY=
GAME_GROUP_ID_2_HANDLER=sx_group_2
GAME_GROUP_ID_2_ENABLED=true

# Category 3 (Sic Bo, handler sx_group_3). Mặc định TẮT. LOBBY / CATEGORY phải khớp config/categories/*.json (sicbo: B, S, T)
GAME_GROUP_ID_3=
GAME_GROUP_ID_3_USERNAME=
GAME_GROUP_ID_3_PASSWORD=
GAME_GROUP_ID_3_LOBBY=
GAME_GROUP_ID_3_CATEGORY=
GAME_GROUP_ID_3_HANDLER=sx_group_3
GAME_GROUP_ID_3_ENABLED=false
