# apps/ai — service pattern predict. Under docker-compose these come from the root .env / compose `environment`.
REDIS_URL=redis://:123456@localhost:6379
# Read-only DB user is preferred (see README); falls back to DATABASE_URL when unset.
DATABASE_URL_READONLY=
DATABASE_URL=postgresql://postgres:123456@localhost:5432/tool_chain
# Fixed consumer name (never run two instances with the same name)
AI_CONSUMER_NAME=ai-worker-0
# Testing only: delay every prediction by N ms (to exercise the DONE deadline in the API)
# AI_ARTIFICIAL_DELAY_MS=0
# LOG_LEVEL=INFO
# History: when recent:{stream_id}:{shoe} is missing rounds, read finished rounds of that shoe from DB within this many hours (default 6)
# AI_HISTORY_DB_WINDOW_HOURS=6
