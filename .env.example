# Read by docker-compose (copy to .env). Values match the previous local dev defaults.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=tool_chain
# Database host used by flyway + api. Local container: DB_HOST=db and run `docker compose --profile local-db up -d`.
# External/managed DB: set its host/port and SSL (POSTGRES_USER/PASSWORD/DB are then that database's credentials).
DB_HOST=db
DB_PORT=5432
# flyway JDBC sslmode: disable | prefer | require
DB_SSLMODE=prefer
# api TLS. Managed DBs with a private CA (e.g. Aiven) need DB_SSL_REJECT_UNAUTHORIZED=false
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
REDIS_PASSWORD=123456

# API (docker-compose). Secrets >= 32 chars each, must differ. Generate: openssl rand -base64 48
CORS_ORIGINS=http://localhost:3001
JWT_SECRET=change-me-generate-a-long-random-string
JWT_REFRESH_SECRET=change-me-generate-another-long-random-string
# TRUST_PROXY=

# web-portal build args (inlined at build time; rebuild after changing)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SHOW_STREAM_DEBUG=false
