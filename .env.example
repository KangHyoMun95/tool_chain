# Read by docker-compose (copy to .env). Values match the previous local dev defaults.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=tool_chain
# Database host used by flyway + api. Local container: DB_HOST=db and run `docker compose --profile local-db up -d`.
# External/managed DB: set its host/port and SSL (POSTGRES_USER/PASSWORD/DB are then that database's credentials).
DB_HOST=db
DB_PORT=5432
# flyway JDBC sslmode: disable | prefer | require
DB_SSLMODE=prefer
# api TLS. Managed DBs with a private CA (e.g. Aiven) need DB_SSL_REJECT_UNAUTHORIZED=false
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
REDIS_PASSWORD=123456

# API (docker-compose). Secrets >= 32 chars each, must differ. Generate: openssl rand -base64 48
CORS_ORIGINS=http://localhost:5001
JWT_SECRET=change-me-generate-a-long-random-string
JWT_REFRESH_SECRET=change-me-generate-another-long-random-string
# TRUST_PROXY=

# web-portal build args (inlined at build time; rebuild after changing)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SHOW_STREAM_DEBUG=false
# Nguồn dự đoán của portal: live (AI thật) hoặc mock (giả lập). Cũng là build arg.
NEXT_PUBLIC_PREDICTION_SOURCE=live

# AI service (apps/ai). Chỉ đọc DB; user chỉ có SELECT thì đặt URL đầy đủ ở đây (xem apps/ai/README.md), để trống thì dùng tài khoản chính.
AI_DATABASE_URL_READONLY=
# AI_LOG_LEVEL=INFO
# AI: thiếu round trong recent:{stream_id}:{shoe} ⇒ đọc bù ván có result của shoe đó từ DB trong số giờ gần nhất này (mặc định 6)
# AI_HISTORY_DB_WINDOW_HOURS=6

# Billing — phí mỗi dự đoán (điểm, số nguyên > 0). Bắt buộc: thiếu / sai thì API dừng.
PREDICTION_FEE=10
# Ván RUNNING không có result quá số phút này thì bị CANCELLED và hoàn tiền (mặc định 5).
# Job chỉ chạy khi GAME_SESSION_CANCEL_ENABLED=true (mặc định false).
# GAME_SESSION_CANCEL_AFTER_MINUTES=5
# GAME_SESSION_CANCEL_ENABLED=false
# false ⇒ KHÔNG hoàn tiền (dự đoán sai, kết quả T, ván CANCELLED). Mặc định true.
# Đổi false → true: sweeper sẽ hoàn bù ván kết thúc trong 7 ngày gần nhất còn subscription chưa hoàn.
# HAS_REFUND=true
# Hub SSE: stream chỉ nhận tick cũ hơn phiên đang giữ liên tục quá số ms này ⇒ xóa state, tick kế tiếp khởi tạo lại (mặc định 60000).
# HUB_STALE_RESET_MS=60000
# true ⇒ log thêm mức DEBUG (mặc định false: chỉ log / warn / error / fatal).
# API_LOG_DEBUG=false
